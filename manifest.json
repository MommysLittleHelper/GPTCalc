{
  "manifest_version": 3,
  "name": "Логистический калькулятор объема",
  "short_name": "Калькулятор",
  "version": "1.3.0",
  "description": "Умный автоанализ габаритов и расчет кубических метров",
  "start_url": "./index.html",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#2563eb",
  "action": {
    "default_popup": "index.html",
    "default_title": "Логистический калькулятор"
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}